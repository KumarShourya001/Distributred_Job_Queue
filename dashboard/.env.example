# Copy to .env. Vite only exposes variables prefixed with VITE_ to browser code —
# everything in the bundle is public, so never put a secret behind this prefix.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# In production these become the deployed API, over TLS.
# Note wss:// not ws:// — a page served over HTTPS cannot open an insecure socket.
# VITE_API_URL=https://your-api.herokuapp.com
# VITE_WS_URL=wss://your-api.herokuapp.com
