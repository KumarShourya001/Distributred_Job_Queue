# Copy to .env and fill in real values. Never commit .env.


# ---- database ----

# MongoDB connection string. Must point at a replica set (Atlas free tier works)
# because the live dashboard relies on change streams.
#
# SRV form (needs working DNS SRV lookups):
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/jobqueue?retryWrites=true&w=majority
#
# Non-SRV form (use this if you get querySrv ECONNREFUSED):
#   mongodb://<user>:<pass>@shard-00-00.xxx.mongodb.net:27017,shard-00-01.xxx.mongodb.net:27017/jobqueue?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGO_URI=

# Same cluster, different database name (e.g. jobqueue_test). The test suite wipes
# this collection between tests and refuses to run if this is unset, so it can never
# be pointed at real data by accident.
MONGO_URI_TEST=


# ---- server ----

# Port for the API + WebSocket server. Defaults to 3000 if unset.
PORT=3000

# Origin allowed by CORS. Defaults to http://localhost:5173 (the Vite dev server).
# Set this to the deployed dashboard URL in production.
CORS_ORIGIN=http://localhost:5173


# ---- security ----

# Shared secret required on every request under /jobs, sent as the X-API-Key header.
# The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY=

# Optional comma-separated allowlist of hosts the http_request handler may reach.
# When set it replaces the default denylist entirely: only these hosts are permitted.
# When unset, loopback / private / link-local / IPv4-mapped addresses are blocked.
#   ALLOWED_HOSTS=webhook.site,example.com
ALLOWED_HOSTS=

# Token bucket rate limit, applied per client IP before authentication.
# RATE_BURST is the largest burst allowed; RATE_REFILL_PER_SEC is the sustained rate.
# Defaults: 20 and 2.
RATE_BURST=20
RATE_REFILL_PER_SEC=2


# ---- worker tuning ----

# Jobs a single worker may run at once. Defaults to 1 (fully serial).
CONCURRENCY=1

# How often a running job renews its lease by touching claimedAt. Defaults to 10000.
# Must be comfortably below LEASE_MS or a live job gets reclaimed as stranded.
HEARTBEAT_MS=10000

# How long a job may sit in "claimed" before the sweeper assumes the worker died
# and returns it to pending. Defaults to 30000.
LEASE_MS=30000
# Cap on RUNNABLE pending jobs (runAt in the past). New submissions are refused with
# 503 "queue is full" above this. Scheduled jobs are counted separately below.
MAX_QUEUE_DEPTH=10000

# Cap on SCHEDULED pending jobs (runAt in the future). Refused with 503 "too many
# scheduled jobs". Kept separate so a backlog of future work cannot block work due now.
MAX_SCHEDULED=10000

# How far ahead a job may be scheduled, in days. Bounds how long a pending job can
# occupy the scheduled budget, since pending jobs never expire (the TTL is on finishedAt).
MAX_RUNAT_DAYS=3

# Number of proxy hops to trust for req.ip, used by the rate limiter. Leave unset when
# running directly. Set to 1 behind a single reverse proxy (Heroku, Railway, Vercel).
# Setting this when there is no proxy lets a caller spoof X-Forwarded-For and get a
# fresh rate limit bucket per request.
TRUST_PROXY=

# Secret used to sign session JWTs. The server refuses to start without it.
# Changing it invalidates every existing session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# How long a session lasts, in jsonwebtoken's format (e.g. 7d, 12h, 30m).
SESSION_TTL=7d

# development | production. In production the session cookie is set with
# secure:true, which means HTTPS only - login will not work over plain http.
NODE_ENV=development
